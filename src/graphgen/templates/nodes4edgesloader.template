Example:
UNWIND [
    {{node_id: "Vladimir Putin", node_name: "Vladimir Putin", node_type: "Person", wikidata_id: "Q7747", english_name: "Vladimir Putin", start_datetime: null, end_datetime: null, raw_text: "Vladimir Putin", raw_source: "document.pdf", chunk_id: null, raw_source_line: null}},
    {{node_id: "Russia", node_name: "Russia", node_type: "Location", wikidata_id: "Q159", english_name: "Russia", start_datetime: null, end_datetime: null, raw_text: "Russia", raw_source: "document.pdf", chunk_id: null, raw_source_line: null}}
] AS erow

// Step 1 Check existence of source node by node_id (canonical key)
OPTIONAL MATCH (s) WHERE erow.source_id = s.node_id
WITH s, erow
// Pass matched or unmatched source nodes
CALL (s, erow) {{
    MERGE (s_new {{node_id: erow.source_id}})
    ON CREATE SET
        s_new.node_name = [erow.source_id],
        s_new.english_name = [erow.source_id],
        s_new.node_id = erow.source_id,
        s_new.node_type = [],
        s_new.chunk_id = COALESCE(erow.chunk_id, null),
        s_new.raw_source_line = COALESCE(erow.raw_source_line, null),
        s_new.raw_text = [COALESCE(erow.raw_source, "") + "::" + COALESCE(erow.raw_text, "")],
        s_new.raw_source = [x IN [COALESCE(erow.raw_source, "")] WHERE x IS NOT NULL]
    RETURN s_new
}}

// Step 2 Check existence of target node by node_id (canonical key)
OPTIONAL MATCH (t) WHERE erow.target_id = t.node_id
WITH t, erow, s_new
// Pass matched or unmatched target nodes
CALL (t, erow, s_new) {{
    MERGE (t_new {{node_id: erow.target_id}})
    ON CREATE SET
        t_new.node_name = [erow.target_id],
        t_new.english_name = [erow.target_id],
        t_new.node_id = erow.target_id,
        t_new.node_type = [],
        t_new.chunk_id = COALESCE(erow.chunk_id, null),
        t_new.raw_source_line = COALESCE(erow.raw_source_line, null),
        t_new.raw_text = [COALESCE(erow.raw_source, "") + "::" + COALESCE(erow.raw_text, "")],
        t_new.raw_source = [x IN [COALESCE(erow.raw_source, "")] WHERE x IS NOT NULL]
    RETURN t_new
}}
WITH s_new, t_new, erow

// DO NOT CREATE ANY RELATIONSHIPS/EDGES HERE
// This step only creates nodes. Edges will be created by EdgesLoaderAgent.

// Final RETURN for debugging
RETURN s_new, t_new;


